# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# fichiers uploadés depuis l'admin (migrés vers Vercel Blob, ne doivent plus
# être versionnés — les fichiers déjà commités avant cette migration restent
# dans l'historique, cette règle ne bloque que les nouveaux ajouts)
/public/uploads

# typescript
*.tsbuildinfo
next-env.d.ts
