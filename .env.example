# Copier en .env.local (développement) ou .env.production (VPS, lu par Next au
# démarrage). Ne jamais commiter de vraies valeurs.

# --- Base de données ---------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/instinct

# --- Authentification (NextAuth) --------------------------------------------
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=
# URL publique du site : utilisée pour les liens et le logo des mails.
NEXTAUTH_URL=http://localhost:3000

# --- Mails (SMTP) -------------------------------------------------------------
# Local : Mailpit (localhost:1025, interface sur le port 8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ORDER_NOTIFY_EMAIL=

# --- Stockage des fichiers uploadés depuis l'admin (S3 / OVH Object Storage) --
# Les fichiers partent directement du navigateur vers le bucket (URL pré-signée).
# Le bucket doit avoir sa configuration CORS : node --env-file=.env.local scripts/s3-setup-cors.mjs
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publique du bucket, sans slash final. Son domaine est autorisé
# automatiquement dans images.remotePatterns de next.config.ts.
S3_PUBLIC_BASE_URL=https://<bucket>.s3.gra.io.cloud.ovh.net

# --- Boutique en ligne ----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOXTAL_ENV=sandbox
BOXTAL_ACCESS_KEY=
BOXTAL_SECRET_KEY=
BOXTAL_WEBHOOK_SECRET=
# Protège /api/cron/release-stock (appelé par un cron).
CRON_SECRET=
